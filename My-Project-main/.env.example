# .env.example – Copy this file to .env for local development.
# On Render, set these under Environment Variables in the dashboard.

# A strong random string for Flask session security
SECRET_KEY=your-secret-key-here

# Set to "production" on Render
FLASK_ENV=production

# (Optional) Override the database URL – defaults to SQLite for the free tier
# DATABASE_URL=sqlite:///instance/portfolio.db
